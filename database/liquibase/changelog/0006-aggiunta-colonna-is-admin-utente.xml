<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0006-aggiunta-colonna-is-admin-utente" author="mondopt">
        <addColumn tableName="utente">
            <column name="is_admin" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="0007-imposta-primo-admin" author="mondopt">
        <update tableName="utente">
            <column name="is_admin" valueBoolean="true"/>
            <where>email = '${admin.email}'</where>
        </update>
    </changeSet>

</databaseChangeLog>
