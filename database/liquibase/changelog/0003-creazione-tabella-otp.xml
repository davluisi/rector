<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="3" author="antigravity">
        <createTable tableName="otp_verifica">
            <column name="email" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="codice" type="VARCHAR(4)">
                <constraints nullable="false"/>
            </column>
            <column name="scadenza" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="verificato" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="data_verifica" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
